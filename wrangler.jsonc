{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker is named `dypolblog` — no hyphen — and serves
  // https://dypolblog.rstmcsoch.workers.dev. Branch previews are
  // `<branch>-dypolblog.<subdomain>.workers.dev` and use the "previews"
  // bindings below, so a preview can never read or write production content.
  //
  // Approved Workers Builds / CLI commands:
  // - Production deploy (`main` branch only): `DYPOL_DEPLOY_TARGET=production npm run deploy:prod`
  // - Preview build/upload (non-`main` branches): `DYPOL_DEPLOY_TARGET=preview npm run deploy:preview`
  // - Preview D1 migrations (`dypol-blog-db-preview` only): `DYPOL_DEPLOY_TARGET=preview npm run db:migrate:preview`
  "name": "dypolblog",
  // The Worker entry adds the Cloudflare Cron Trigger handler (scheduled) on top
  // of TanStack Start's fetch handler. Keep this path in sync with src/worker-entry.ts.
  "main": "src/worker-entry.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "DYPOL_ENV": "production" },
  // Automation tick: every 5 minutes. Each tick reads the stored per-automation
  // schedules (cron + timezone, in D1) and runs only what is due, so a schedule
  // fires within 5 minutes of its chosen time. Cron delivery is at-least-once;
  // automation_schedule.next_run_at is advanced before a run starts and the run
  // is claimed with a conditional UPDATE, so a repeated tick cannot duplicate an
  // article. Advanced: set "0 * * * *" for hourly granularity.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dypol-blog-db",
      "database_id": "78708341-8467-4140-bfa7-0531f14a7aee",
      "migrations_dir": "migrations/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dypol-blog-media"
    }
  ],
  // Sign-in throttle: 5 attempts / 60 s per client IP (src/lib/auth/sign-in-limit.ts).
  "ratelimits": [
    { "name": "SIGNIN_LIMITER", "namespace_id": "7301", "simple": { "limit": 5, "period": 60 } },
    // MCP endpoint + OAuth: 30 requests / 60 s per client IP (src/lib/mcp/http.server.ts).
    { "name": "MCP_LIMITER", "namespace_id": "7303", "simple": { "limit": 30, "period": 60 } }
  ],
  // `wrangler preview` (Workers Builds on non-production branches) uses these
  // instead, so previews can never read or write production content.
  "previews": {
    "vars": { "DYPOL_ENV": "preview" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "dypol-blog-db-preview",
        "database_id": "c9030fb4-8657-47d9-bf6f-e8c11650bdd5",
        "migrations_dir": "migrations/d1"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "dypol-blog-media-preview"
      }
    ],
    "ratelimits": [
      { "name": "SIGNIN_LIMITER", "namespace_id": "7302", "simple": { "limit": 5, "period": 60 } },
      { "name": "MCP_LIMITER", "namespace_id": "7304", "simple": { "limit": 30, "period": 60 } }
    ]
  }
  // Secrets (set with `wrangler secret put`, never committed):
  //   ADMIN_TOKEN           editor sign-in token (16+ chars; use 32+ random)
  //   ADMIN_SESSION_SECRET  optional, signs the desk cookie; rotate it (or
  //                         ADMIN_TOKEN) to sign every editor out
  //   MCP_TOKEN             enables the /mcp automation endpoint (32+ chars);
  //                         unset = endpoint disabled (503). Separate from ADMIN_TOKEN.
  //   CRON_SECRET           optional, authorises POST/GET /api/automation/tick for an
  //                         external cron. Unset falls back to MCP_TOKEN.
  //   AI key secrets        server-api automations only. Each automation names the ONE
  //                         secret it may use, so automations never share a key by
  //                         accident: AUTOMATION_A_KEY … AUTOMATION_D_KEY (per-automation
  //                         slots), or XAI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY /
  //                         GEMINI_API_KEY / OPENROUTER_API_KEY / AI_API_KEY.
  // Var (optional): MCP_OAUTH_REDIRECT_HOSTS  comma list of extra MCP client hosts
}

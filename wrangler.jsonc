{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One config for both Workers (dypolblog and dypol-blog). Workers Builds
  // overrides "name" per Worker, so both get the same bindings below.
  "name": "dypolblog",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dypol-blog-db",
      "database_id": "78708341-8467-4140-bfa7-0531f14a7aee",
      "migrations_dir": "migrations/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dypol-blog-media"
    }
  ]
  // Secrets (set with `wrangler secret put`, never committed):
  //   ADMIN_TOKEN           editor sign-in token (16+ chars)
  //   ADMIN_SESSION_SECRET  optional, signs the desk cookie
}
